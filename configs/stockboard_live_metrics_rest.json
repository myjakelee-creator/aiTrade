{
  "schema_version": 8,
  "enabled": true,
  "rollout_stage": 4,
  "mode": "kiwoom_rest_lowload_v1",
  "query_suffix": "_AL",
  "query_suffix_by_session": {
    "before_market": "_AL",
    "regular": "_AL",
    "aftermarket": "_AL"
  },
  "max_top_codes": 20,
  "global_min_request_gap_sec": 2.0,
  "health_stable_sec": 10,
  "price_stall_guard_sec": 30,
  "selected_refresh_sec": 5,
  "loop_sleep_sec": 1.0,
  "error_backoff_sec": 30,
  "regular_session": {
    "start": "09:00",
    "end": "15:30"
  },
  "aftermarket_session": {
    "start": "15:30",
    "end": "20:00"
  },
  "before_market_session": {
    "start": "00:00",
    "end": "08:00"
  },
  "opening_window": {
    "start": "09:00",
    "end": "09:10"
  },
  "realtime_strength_ws": {
    "stage": 2,
    "enabled": true,
    "scope": "top20",
    "max_symbols": 20,
    "url": "wss://api.kiwoom.com:10000/api/dostk/websocket",
    "type": "0B",
    "strength_field": "228",
    "time_field": "20",
    "exchange_field": "9081",
    "group_no": "41",
    "apply_interval_ms": 1000,
    "stale_after_sec": 20,
    "selection_refresh_sec": 5,
    "reconnect_backoff_sec": 10,
    "connect_timeout_sec": 10,
    "receive_timeout_sec": 2
  },
  "six_metric_lifecycle": {
    "enabled": true,
    "groups": [
      "amount_ratio",
      "orderbook",
      "execution",
      "strength5",
      "program",
      "large_trade"
    ],
    "snapshot_file": "six_metric_lifecycle.json",
    "save_interval_sec": 5,
    "closed_display_until": "next_premarket",
    "active_session_policy": "current_trading_date_only",
    "closed_session_policy": "last_completed_trading_date_only",
    "unknown_date_policy": "hide",
    "missing_numeric_policy": "dash_not_zero"
  },
  "metrics": {
    "bidask": {
      "stage": 1,
      "api_id": "ka10004",
      "path": "/api/dostk/mrkcond",
      "regular_interval_sec": {
        "s1": 10,
        "top20": 60
      },
      "aftermarket_interval_sec": {
        "s1": 10,
        "top20": 60
      },
      "before_market_interval_sec": {
        "s1": 900,
        "top20": 21600
      },
      "opening_interval_sec": {
        "s1": 30,
        "top20": 300
      }
    },
    "strength": {
      "stage": 3,
      "purpose": "5분·20분·60분 강도 전용; 체결강도에는 사용 금지",
      "strength_5m_apply_stage": 3,
      "api_id": "ka10046",
      "path": "/api/dostk/mrkcond",
      "regular_interval_sec": {
        "s1": 15,
        "top20": 90
      },
      "aftermarket_interval_sec": {
        "s1": 30,
        "top20": 180
      },
      "before_market_interval_sec": {
        "s1": 900,
        "top20": 21600
      },
      "opening_interval_sec": {
        "s1": 45,
        "top20": 300
      }
    },
    "large_trade": {
      "stage": 4,
      "api_id": "ka10055",
      "path": "/api/dostk/stkinfo",
      "threshold_krw": 50000000,
      "regular_interval_sec": {
        "s1": 60,
        "top20": 300
      },
      "aftermarket_interval_sec": {
        "s1": 120,
        "top20": 600
      },
      "before_market_interval_sec": {
        "s1": 0,
        "top20": 0
      },
      "opening_interval_sec": {
        "s1": 180,
        "top20": 0
      },
      "first_page_only": true,
      "baseline_first_response": false
    }
  },
  "performance_contract": {
    "price_collector_changes": 0,
    "new_qax_processes": 0,
    "new_realtime_fids": 0,
    "browser_calculation": false,
    "single_background_thread": true,
    "single_request_inflight": true,
    "top_scope_only": true,
    "realtime_strength_ws_connections": 1,
    "realtime_strength_ws_symbols": 20,
    "realtime_strength_batch_apply_hz_max": 1,
    "six_metric_lifecycle_threads": 0,
    "six_metric_lifecycle_network_requests": 0,
    "six_metric_lifecycle_snapshot_write_min_interval_sec": 5,
    "large_trade_stage4_threads": 0,
    "large_trade_stage4_min_request_gap_sec": 2,
    "opening_heavy_render_interval_ms": 1000
  }
}
