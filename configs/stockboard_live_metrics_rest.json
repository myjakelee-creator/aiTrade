{
  "schema_version": 4,
  "enabled": true,
  "rollout_stage": 2,
  "mode": "kiwoom_rest_lowload_v1",
  "query_suffix": "_AL",
  "query_suffix_by_session": {
    "regular": "_AL",
    "aftermarket": "_NX"
  },
  "max_top_codes": 20,
  "global_min_request_gap_sec": 2.0,
  "health_stable_sec": 10,
  "price_stall_guard_sec": 30,
  "selected_refresh_sec": 5,
  "loop_sleep_sec": 1.0,
  "error_backoff_sec": 30,
  "regular_session": {
    "start": "09:00",
    "end": "15:30"
  },
  "aftermarket_session": {
    "start": "15:30",
    "end": "20:00"
  },
  "opening_window": {
    "start": "09:00",
    "end": "09:10"
  },
  "realtime_strength_ws": {
    "stage": 2,
    "enabled": true,
    "scope": "s1_only",
    "url": "wss://api.kiwoom.com:10000/api/dostk/websocket",
    "type": "0B",
    "strength_field": "228",
    "time_field": "20",
    "exchange_field": "9081",
    "group_no": "41",
    "apply_interval_ms": 1000,
    "stale_after_sec": 20,
    "selection_refresh_sec": 5,
    "reconnect_backoff_sec": 10,
    "connect_timeout_sec": 10,
    "receive_timeout_sec": 2,
    "close_hold": {
      "enabled": true,
      "save_interval_sec": 5,
      "display_until": "next_premarket",
      "display_phases": [
        "closed",
        "before_market",
        "weekend",
        "holiday"
      ],
      "snapshot_file": "realtime_strength_final_hold.json"
    }
  },
  "metrics": {
