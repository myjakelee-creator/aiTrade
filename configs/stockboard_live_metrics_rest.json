      "stage": 1,
      "api_id": "ka10004",
      "path": "/api/dostk/mrkcond",
      "regular_interval_sec": {
        "s1": 10,
        "top20": 60
      },
      "aftermarket_interval_sec": {
        "s1": 10,
        "top20": 60
      },
      "opening_interval_sec": {
        "s1": 30,
        "top20": 300
      }
    },
    "strength": {
      "stage": 3,
      "purpose": "5분·20분·60분 강도 전용; 순간강도에는 사용 금지",
      "strength_5m_apply_stage": 3,
      "api_id": "ka10046",
      "path": "/api/dostk/mrkcond",
      "regular_interval_sec": {
        "s1": 15,
        "top20": 90
      },
      "aftermarket_interval_sec": {
        "s1": 30,
        "top20": 180
      },
      "opening_interval_sec": {
        "s1": 45,
        "top20": 300
      }
    },
    "large_trade": {
      "stage": 4,
      "api_id": "ka10055",
      "path": "/api/dostk/stkinfo",
      "threshold_krw": 50000000,
      "regular_interval_sec": {
        "s1": 30,
        "top20": 180
      },
      "aftermarket_interval_sec": {
        "s1": 60,
        "top20": 300
