{
  "schema_version": 1,
  "id": "RELATIVE_STRENGTH_OPENING_V01",
  "name": "시장 대비 상대강도형",
  "runtime_status": "design_ready_not_loaded_yet",
  "purpose": "시장이 약하거나 애매할 때 시장보다 먼저 강해지는 종목을 선발한다.",
  "grade_policy": {
    "mode": "pool_percentile_calibrated",
    "bands": [
      {"grade": "A", "percentile_top": 15},
      {"grade": "B", "percentile_top": 35},
      {"grade": "C", "percentile_top": 65},
      {"grade": "D", "percentile_top": 85},
      {"grade": "F", "percentile_top": 100}
    ]
  },
  "orderbook_policy": {
    "name": "relative_strength_sell_wall_absorption",
    "principle": "시장보다 강한 종목이 매도잔량 우위에서도 밀리지 않으면 흡수로 가점한다.",
    "favorable": ["relative_strength > 0", "ask_pct > bid_pct", "price >= vwap_or_open", "realtime_strength >= 100"]
  },
  "stages": {
    "top50": [
      {"key": "trade_value_rank", "weight": 20},
      {"key": "rank_gap", "weight": 20},
      {"key": "market_relative_change_rate", "weight": 30},
      {"key": "trade_value_growth", "weight": 30}
    ],
    "top20": [
      {"key": "relative_strength_continuation", "weight": 30},
      {"key": "realtime_strength", "weight": 25},
      {"key": "above_vwap", "weight": 20},
      {"key": "program_or_foreign_flow", "weight": 15},
      {"key": "sell_wall_absorption", "weight": 10}
    ],
    "top5": [
      {"key": "green_while_market_weak", "weight": 30},
      {"key": "one_min_net_buy_value_growth", "weight": 30},
      {"key": "near_high_hold", "weight": 20},
      {"key": "spike_reversal_penalty", "weight": -20}
    ]
  },
  "funnel": {
    "top50": {"take": 50},
    "top20": {"from": "top50", "take": 20},
    "top5": {"from": "top20", "take": 5}
  }
}
