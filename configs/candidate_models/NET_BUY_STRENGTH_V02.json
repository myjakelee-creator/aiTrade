      "label": "순위",
      "max_score": 100,
      "method": "filtered_pool_rank_100_to_0"
    },
    {
      "key": "previous_rank",
      "label": "전일",
      "max_score": 100,
      "method": "min(max(prev_rank-rank,0),100)"
