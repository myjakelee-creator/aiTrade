    {
      "key": "trade_value_ratio",
      "label": "금액(억)",
      "max_score": 100,
      "method": "rank(trade_value_eok/prev_trade_value_eok)_100_to_0",
      "fallback_score": 60
    },
    {
      "key": "ask_share",
      "label": "잔량비",
      "max_score": 100,
      "method": "ask_volume/(bid_volume+ask_volume)*100"
    },
    {
      "key": "instant_strength",
      "label": "순간강도",
      "max_score": 100,
      "method": "execution_strength absolute score"
    },
    {
      "key": "five_min_strength",
      "label": "5분강도",
      "max_score": 100,
      "method": "Kiwoom strength_5m absolute score",
      "missing_score": 0
