{
  "schema_version": 1,
  "id": "NET_BUY_STRENGTH_V02",
  "name": "순매수 강도 v0.2",
  "label": "순매수 강도 v0.2",
  "runtime_status": "ranking_engine_ready_not_wired",
  "runtime_engine": "stockboard_ranking_engine.enrich_net_buy_strength_v02_fields",
  "purpose": "순위, 전일 순위상승, 거래대금/전일 거래대금, 잔량비, 순간강도, 1분강도, 프로그램 순매수/거래대금을 100점씩 평가해 총점이 높은 종목부터 전체 줄세우기한다.",
  "total_points": 700,
  "items": [
    {"key": "rank", "label": "순위", "max_score": 100, "method": "filtered_pool_rank_100_to_0"},
    {"key": "previous_rank", "label": "전일", "max_score": 100, "method": "min(max(prev_rank-rank,0),100)"},
    {"key": "trade_value_ratio", "label": "금액(억)", "max_score": 100, "method": "rank(trade_value_eok/prev_trade_value_eok)_100_to_0", "fallback_score": 60, "fallback_label": "전일대금 미확인 60점"},
    {"key": "ask_share", "label": "잔량비", "max_score": 100, "method": "ask_volume/(bid_volume+ask_volume)*100"},
    {"key": "instant_strength", "label": "순간강도", "max_score": 100, "method": "min(max(realtime_strength,0),200)/200*100"},
    {"key": "one_min_strength", "label": "1분강도", "max_score": 100, "method": "rank(one_min_strength_growth_rate or one_min_strength_delta)_100_to_0"},
    {"key": "program_ratio", "label": "프로(억)", "max_score": 100, "method": "rank(program_net/trade_value_eok)_100_to_0_when_program_net_positive", "zero_rule": "program_net<=0 => 0"}
  ],
  "grade_policy": {
    "display": "letter_with_score",
    "base_bands": {
      "A": 91,
      "B": 81,
      "C": 71,
      "D": 61,
      "F": 0
    },
    "fixed_rule": "60점 이하는 F, 61점부터 D"
  },
  "pool_policy": {
    "sort": "score_total_points desc, rank asc, trade_value_eok desc",
    "top5": {"from_rank": 1, "to_rank": 5, "lane": "HOT"},
    "top20": {"from_rank": 6, "to_rank": 20, "lane": "HOT"},
    "top50": {"from_rank": 21, "to_rank": 50, "lane": "MID"},
    "top300": {"from_rank": 51, "to_rank": null, "lane": "POOL"}
  },
  "data_requirements": {
    "required_for_full_score": [
      "rank",
      "prev_rank",
      "trade_value_eok",
      "prev_trade_value_eok",
      "bid_volume or bid_volume_snapshot",
      "ask_volume or ask_volume_snapshot",
      "realtime_strength or execution_strength",
      "one_min_strength_growth_rate or one_min_strength_delta",
      "program_net"
    ],
    "never_store_missing_as_zero": ["prev_trade_value_eok"],
    "fallback": "전일 거래대금 최종 실패 시 금액(억) 항목 60점 고정 + 화면 표시"
  }
}
