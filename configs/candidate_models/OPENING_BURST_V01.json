  "name": "장초반 폭발 확인형 · 5분강도",
  "label": "폭발 확인형 · 5분강도",
  "runtime_status": "design_ready_loaded_with_current_engine_mapping",
  "purpose": "09:00 직후 거래대금과 체결강도가 동시에 폭발하는 종목을 감시하며 기존 1분강도 가속 항목은 키움 조회 기반 5분강도로 교체한다.",
  "grade_policy": {
    "mode": "absolute_market_calibrated",
    "distribution": "natural_not_forced",
