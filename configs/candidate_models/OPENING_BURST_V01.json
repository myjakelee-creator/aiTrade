      "A": 90,
      "B": 80,
      "C": 70,
      "D": 60,
      "F": 0
    },
    "a_grade_guards": [
      "price >= vwap_or_open",
      "realtime_strength >= 100",
      "score_has_money_flow_confirmation"
    ]
  },
  "promotion_demotion_policy": {
    "principle": "group_membership_is_result_not_score_source",
    "score_all_rows_for_entry": true,
