{
  "schema_version": 1,
  "id": "OPENING_BURST_V01",
  "name": "장초반 폭발 확인형",
  "runtime_status": "design_ready_not_loaded_yet",
  "purpose": "09:00 직후 거래대금과 체결강도가 동시에 폭발하는 종목을 빠르게 감시 대상으로 올린다.",
  "grade_policy": {
    "mode": "absolute_market_calibrated",
    "distribution": "natural_not_forced",
    "base_bands": {"A": 85, "B": 75, "C": 62, "D": 50, "F": 0},
    "market_adjustment": {
      "strong": {"A": 82, "B": 72, "C": 60, "D": 45},
      "neutral": {"A": 85, "B": 75, "C": 62, "D": 50},
      "weak": {"A": 90, "B": 80, "C": 68, "D": 55},
      "very_weak": {"A": 92, "B": 84, "C": 72, "D": 60}
    },
    "a_grade_guards": ["price >= vwap_or_open", "realtime_strength >= 100", "score_has_money_flow_confirmation"]
  },
  "promotion_demotion_policy": {
    "principle": "group_membership_is_result_not_score_source",
    "score_all_rows_for_entry": true,
    "top50": "top 50 by entry_score from Top300",
    "top20": "top 20 by confirmation_score from Top50",
    "top5": "top 5 by focus_score from Top20",
    "refresh_behavior": "every refresh can promote or demote rows"
  },
  "orderbook_policy": {
    "name": "aggressive_sell_wall_absorption",
    "principle": "폭발형에서도 매도잔량 우위 + 매수체결 우위 + 가격 유지가 함께 있을 때만 흡수로 가점한다.",
    "favorable": ["ask_pct > 55", "bid_pct < 45", "realtime_strength >= 120", "price >= open"],
    "penalty": ["upper_wick_reversal", "one_min_trade_value_collapse", "strength_drop_below_100"]
  },
  "score_structure": {
    "entry_score": [
      {"key": "trade_value_rank", "weight": 25},
      {"key": "rank_gap", "weight": 25},
      {"key": "trade_value_growth", "weight": 25},
      {"key": "change_rate_reaction", "weight": 15},
      {"key": "above_open", "weight": 10}
    ],
    "confirmation_score": [
      {"key": "one_min_trade_value_burst", "weight": 30},
      {"key": "realtime_strength_rank", "weight": 25},
      {"key": "one_min_net_buy_value_growth", "weight": 25},
      {"key": "sell_wall_absorption", "weight": 10},
      {"key": "session_strength", "weight": 10}
    ],
    "focus_score": [
      {"key": "one_min_strength_acceleration", "weight": 25},
      {"key": "breakout_or_above_open", "weight": 25},
      {"key": "rank_gap_continuation", "weight": 20},
      {"key": "no_trade_value_collapse", "weight": 15},
      {"key": "spike_reversal_penalty", "weight": -30}
    ],
    "grade_score_weights": {"entry_score": 0.30, "confirmation_score": 0.40, "focus_score": 0.30}
  },
  "funnel": {
    "top50": {"take": 50, "score": "entry_score"},
    "top20": {"from": "top50", "take": 20, "score": "confirmation_score"},
    "top5": {"from": "top20", "take": 5, "score": "focus_score"}
  }
}
