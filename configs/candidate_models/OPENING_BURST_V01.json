  },
  "orderbook_policy": {
    "name": "aggressive_sell_wall_absorption",
    "principle": "폭발형에서도 매도잔량 우위 + 매수체결 우위 + 가격 유지가 함께 있을 때만 흡수로 가점한다.",
    "favorable": [
      "ask_pct > 55",
      "bid_pct < 45",
      "realtime_strength >= 120",
      "price >= open"
    ],
    "penalty": [
      "upper_wick_reversal",
      "one_min_trade_value_collapse",
      "strength_drop_below_100"
    ]
  },
