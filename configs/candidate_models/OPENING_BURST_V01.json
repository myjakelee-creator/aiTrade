{
  "schema_version": 1,
  "id": "OPENING_BURST_V01",
  "name": "장초반 폭발 확인형",
  "runtime_status": "design_ready_not_loaded_yet",
  "purpose": "09:00 직후 거래대금과 체결강도가 동시에 폭발하는 종목을 빠르게 감시 대상으로 올린다.",
  "grade_policy": {
    "mode": "pool_percentile_calibrated",
    "bands": [
      {"grade": "A", "percentile_top": 15},
      {"grade": "B", "percentile_top": 35},
      {"grade": "C", "percentile_top": 65},
      {"grade": "D", "percentile_top": 85},
      {"grade": "F", "percentile_top": 100}
    ]
  },
  "orderbook_policy": {
    "name": "aggressive_sell_wall_absorption",
    "principle": "폭발형에서도 매도잔량 우위 + 매수체결 우위 + 가격 유지가 함께 있을 때만 흡수로 가점한다.",
    "favorable": ["ask_pct > 55", "bid_pct < 45", "realtime_strength >= 120", "price >= open"],
    "penalty": ["upper_wick_reversal", "one_min_trade_value_collapse", "strength_drop_below_100"]
  },
  "stages": {
    "top50": [
      {"key": "trade_value_rank", "weight": 30},
      {"key": "rank_gap", "weight": 30},
      {"key": "change_rate_rank", "weight": 20},
      {"key": "trade_value_growth", "weight": 20}
    ],
    "top20": [
      {"key": "one_min_trade_value_growth", "weight": 35},
      {"key": "realtime_strength_rank", "weight": 25},
      {"key": "one_min_net_buy_value_growth", "weight": 30},
      {"key": "session_strength", "weight": 10}
    ],
    "top5": [
      {"key": "one_min_strength_growth", "weight": 30},
      {"key": "breakout_or_above_open", "weight": 25},
      {"key": "rank_gap_continuation", "weight": 25},
      {"key": "spike_reversal_penalty", "weight": -30}
    ]
  },
  "funnel": {
    "top50": {"take": 50},
    "top20": {"from": "top50", "take": 20},
    "top5": {"from": "top20", "take": 5}
  }
}
