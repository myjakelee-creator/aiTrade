{
  "schema_version": 2,
  "enabled": true,
  "completed_candle_only": true,
  "exit_hold_minutes": 2,
  "fade_minutes": 1,
  "reference_order": ["open", "vwap"],
  "display": {
    "replace_grade_badge": true,
    "dual_badge_mode": "alternate",
    "alternate_interval_ms": 1200
  },
  "top_alert": {
    "enabled": true,
    "page_size": 4,
    "rotate_interval_ms": 1800,
    "max_items": 300
