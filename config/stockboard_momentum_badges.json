  "rules": [
    {
      "id": "open_breakout",
      "reference": "open",
      "badge": "시돌",
      "label": "시가돌파",
      "tone": "strong_up",
      "priority": 100,
      "requires_previous": true,
      "all": [
        {"left": "C", "op": ">", "right": "dayOpen"},
        {"left": "C1", "op": "<", "right": "dayOpen"}
      ],
      "stay": [
        {"left": "C", "op": ">", "right": "dayOpen"}
      ]
    },
    {
      "id": "open_breakdown",
      "reference": "open",
      "badge": "시붕",
      "label": "시가붕괴",
      "tone": "strong_down",
      "priority": 100,
      "requires_previous": true,
      "all": [
        {"left": "C", "op": "<", "right": "dayOpen"},
        {"left": "C1", "op": ">", "right": "dayOpen"}
